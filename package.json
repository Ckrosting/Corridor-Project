{
  "name": "hull-corridor",
  "version": "0.1.0",
  "private": true,
  "description": "Hull Corridor - corridor property research, cold-calling, and acquisition pipeline for Hull Property Group",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "db:up": "node scripts/pg-local.mjs start",
    "db:down": "node scripts/pg-local.mjs stop",
    "db:status": "node scripts/pg-local.mjs status",
    "db:nuke": "node scripts/pg-local.mjs nuke",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "worker": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "release": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
