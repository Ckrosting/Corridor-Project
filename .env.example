# ============================================================================
# Hull Corridor - environment configuration
# Copy to `.env` and fill in.  NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local: `npm run db:up` prints this exact value.
# Railway: use the Postgres service's DATABASE_URL reference variable.
DATABASE_URL=postgresql://hullcorridor:hullcorridor_local@127.0.0.1:5433/hull_corridor

# Require TLS to the database. Leave false locally; set true in production.
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Public origin of the app. Railway: https://<your-service>.up.railway.app
AUTH_URL=http://localhost:3000

# DEVELOPMENT ONLY. When true, the app seeds a local owner account and shows a
# one-click sign-in button on the login page. This is hard-disabled whenever
# NODE_ENV=production, regardless of this value. Never set true in production.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=ckrosting@hullpg.com

# ---------------------------------------------------------------------------
# File storage (attachments: flyers, OMs, photos, documents)
# ---------------------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR. Fine for development only - Railway's
# application filesystem is ephemeral and will lose uploads on redeploy.
# "s3" targets any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO). Use "s3" in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads

# Required when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2 and MinIO need path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true

# Max upload size in megabytes.
UPLOAD_MAX_MB=25

# ---------------------------------------------------------------------------
# Anthropic / AI discovery  (OPTIONAL - the whole app works without this)
# ---------------------------------------------------------------------------
# Server-side only. This value is never sent to the browser, never logged, and
# must never be committed. Leave blank to run with discovery disabled.
ANTHROPIC_API_KEY=

# Model id used for discovery scans. Change without touching code, no redeploy.
# Verified against current Anthropic docs: Sonnet 5 is the current Sonnet-family
# model ($2 / $10 per million input / output tokens).
# Re-check at https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5

# Hard ceilings per scan, to bound cost.
AI_MAX_WEB_SEARCHES_PER_SCAN=12
AI_MAX_OUTPUT_TOKENS=8000

# Monthly spend ceiling in USD. Scans refuse to start once recorded spend for
# the current month reaches this value. 0 = refuse all scans.
AI_MONTHLY_BUDGET_USD=25

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# How many scan jobs may run at once across all worker processes.
WORKER_CONCURRENCY=2
# Seconds a running job may be silent before it is considered stalled and retried.
WORKER_HEARTBEAT_TIMEOUT_SECONDS=900
WORKER_POLL_INTERVAL_MS=3000

# ---------------------------------------------------------------------------
# Map providers
# ---------------------------------------------------------------------------
# Leaflet renders the map; it is not a source of imagery. Street basemap
# defaults to OpenStreetMap. Satellite requires a configured provider below.
#
# Satellite provider: "" (disabled) | "mapbox" | "maptiler" | "esri"
NEXT_PUBLIC_SATELLITE_PROVIDER=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=

# Geocoding provider: "nominatim" | "mapbox" | "maptiler" | "google"
# nominatim is the no-key default. It is rate limited to ~1 request/second and
# its usage policy forbids heavy/bulk use - fine for occasional address lookup,
# not for batch imports. Configure a paid provider for real volume.
GEOCODER_PROVIDER=nominatim
GEOCODER_API_KEY=
# Contact address sent in the User-Agent, as Nominatim's usage policy requires.
NOMINATIM_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
